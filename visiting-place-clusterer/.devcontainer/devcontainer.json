{
  "name": "Visiting Place Clusterer",
  "dockerComposeFile": "../../docker-compose.yml",
  "service": "visiting-place-clusterer",
  "runServices": [
    "visiting-place-clusterer"
  ],
  "workspaceFolder": "/visiting-place-clusterer/app",
  "overrideCommand": false,
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "files.trimTrailingWhitespace": true,
        "python.defaultInterpreterPath": "/visiting-place-clusterer/.venv/bin/python"
      }
    }
  }
}
