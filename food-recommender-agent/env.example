# ─────────────────────────────────────────────────────────────────────────────
#  .env.example  —  copy to .env and fill in real values
#  ( .env is git-ignored; .env.example is committed )
# ─────────────────────────────────────────────────────────────────────────────


# ════════════════════════════════════════════════════════════════════════════
#  1. OPENROUTER  (the LLM brain of the agent)
# ════════════════════════════════════════════════════════════════════════════
#
#  OpenRouter is a single API that proxies dozens of model providers
#  (OpenAI, Anthropic, Google, Meta, Mistral, DeepSeek, ...). One key,
#  many models — that's why you switched to it.
#
#  How to get a key:
#   1. Go to https://openrouter.ai and sign up.
#   2. Add some credits (pay-as-you-go; ~$5 lasts a long time for testing).
#   3. Open https://openrouter.ai/keys → "Create Key" → copy it.
#   4. Paste it below.
#
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

#  Which model to use. Format: openrouter/<provider>/<model-id>.
#  Browse the catalog at https://openrouter.ai/models — the page for each
#  model shows the exact id you should paste here.
#
#  Some good starting points (all support tool/function calling, which
#  this agent needs):
#
#    openrouter/openai/gpt-4o-mini              # cheap, fast, reliable  ← default
#    openrouter/openai/gpt-4o                   # stronger, pricier
#    openrouter/anthropic/claude-3.5-sonnet     # strong reasoning + tools
#    openrouter/anthropic/claude-3.5-haiku      # fast + cheap Anthropic
#    openrouter/google/gemini-2.0-flash-001     # back to Gemini, via OpenRouter
#    openrouter/meta-llama/llama-3.3-70b-instruct
#    openrouter/mistralai/mistral-large
#
OPENROUTER_MODEL=openrouter/openai/gpt-4o-mini

#  OPTIONAL — OpenRouter shows these on its analytics dashboard so you
#  can see usage broken down per app. Leave blank to skip.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Food Recommender Agent


# ════════════════════════════════════════════════════════════════════════════
#  2. GOOGLE PLACES API  (used for the actual restaurant search)
# ════════════════════════════════════════════════════════════════════════════
#
#  This is a SIMPLE API KEY — NOT a service-account JSON file. Forget
#  everything about gcp-key.json, GOOGLE_APPLICATION_CREDENTIALS, or
#  Vertex AI. None of that is needed for Maps. You just paste a key.
#
#  Step-by-step (~5 min, one-time setup):
#
#   1. Go to https://console.cloud.google.com  and sign in.
#
#   2. Create a project (top bar → "Select a project" → "New Project").
#      Give it any name, e.g. "food-recommender".
#
#   3. Enable billing on the project. Maps requires a billing account
#      attached, but Google gives you $200/month free credit, which is
#      more than enough for development. Billing menu (☰) → "Billing".
#
#   4. Enable the Places API:
#         APIs & Services  →  Library
#         Search:  "Places API"
#         Click it →  "Enable".
#      ⚠️  This codebase calls the *legacy* Nearby Search endpoint
#      (places_api.py uses /maps/api/place/nearbysearch/json), so enable
#      "Places API" — NOT "Places API (New)". They are billed and keyed
#      separately.
#
#   5. Create the key:
#         APIs & Services  →  Credentials  →  "+ Create credentials"
#                                          →  "API key"
#      Copy the key that appears.
#
#   6. (Strongly recommended) Restrict the key so it can't be abused if
#      it leaks:
#         Click the new key → "Edit"
#         "API restrictions" → "Restrict key" → tick "Places API"
#         "Application restrictions" → for server-side use, leave "None"
#         or set "IP addresses" if your server has a fixed IP.
#
#   7. Paste below.
#
GOOGLE_PLACES_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX


# ════════════════════════════════════════════════════════════════════════════
#  3. A2A SERVER  (this agent's own HTTP endpoint — defaults are fine)
# ════════════════════════════════════════════════════════════════════════════
AGENT_HOST=0.0.0.0
AGENT_PORT=8004
AGENT_URL=http://localhost:8004


# ════════════════════════════════════════════════════════════════════════════
#  4. AGENT 3 ADDRESS  (the orchestrator/scheduler that calls this agent)
# ════════════════════════════════════════════════════════════════════════════
AGENT3_URL=http://localhost:8003
