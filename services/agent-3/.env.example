AGENT3_APP_NAME=agent-3
AGENT3_ENVIRONMENT=development
AGENT3_SERVICE_VERSION=0.1.0
AGENT3_HOST=127.0.0.1
AGENT3_PORT=8080
AGENT3_PUBLIC_BASE_URL=http://127.0.0.1:8080
AGENT3_AGENT_CARD_PATH=/.well-known/agent-card.json
AGENT3_A2A_PATH=/a2a
# MCP-backed route estimation
AGENT3_MCP_BASE_URL=http://127.0.0.1:8090
AGENT3_MCP_TIMEOUT_SECONDS=2.0
# External Agent 4 A2A endpoint
AGENT3_AGENT4_BASE_URL=
AGENT3_AGENT4_TIMEOUT_SECONDS=2.0
AGENT3_AGENT4_INVOCATION_MODE=a2a
AGENT3_AGENT4_POLL_INTERVAL_SECONDS=1.0
AGENT3_AGENT4_MAX_WAIT_SECONDS=15.0
AGENT3_FALLBACK_TRAVEL_MINUTES=0
AGENT3_DEFAULT_TRANSPORT_MODE=walking
AGENT3_LOG_LEVEL=INFO
