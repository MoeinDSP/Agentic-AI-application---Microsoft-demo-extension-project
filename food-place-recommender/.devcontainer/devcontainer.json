{
  "name": "Food Place Recommender",
  "dockerComposeFile": "../../docker-compose.yml",
  "service": "food-place-recommender",
  "runServices": [
    "food-place-recommender"
  ],
  "workspaceFolder": "/food-place-recommender/app",
  "overrideCommand": false,
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "files.trimTrailingWhitespace": true,
        "python.defaultInterpreterPath": "/food-place-recommender/.venv/bin/python"
      }
    }
  }
}
